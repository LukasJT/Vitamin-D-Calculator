---
/**
 * Second mid-body ad slot — dropped in near the end of long articles,
 * just before the RelatedArticles rail. Gives a second impression per
 * scrolled reader without a popup.
 */
---
<div class="my-10 flex flex-col items-center border-t border-b border-gray-100 py-6">
  <span class="text-[10px] uppercase tracking-widest text-gray-400 mb-2">Sponsored</span>
  <div class="adsterra-mobile" style="width:320px;height:50px;">
    <script is:inline>
      atOptions = {
        'key' : 'a24ed02f036c8072b93659a97fc59f02',
        'format' : 'iframe',
        'height' : 50,
        'width' : 320,
        'params' : {}
      };
    </script>
    <script is:inline src="https://www.highperformanceformat.com/a24ed02f036c8072b93659a97fc59f02/invoke.js"></script>
  </div>
  <div class="adsterra-desktop" style="width:468px;height:60px;max-width:100%;">
    <script is:inline>
      atOptions = {
        'key' : 'c1ae2784baad856c72f3ba1d209deeac',
        'format' : 'iframe',
        'height' : 60,
        'width' : 468,
        'params' : {}
      };
    </script>
    <script is:inline src="https://www.highperformanceformat.com/c1ae2784baad856c72f3ba1d209deeac/invoke.js"></script>
  </div>
</div>
