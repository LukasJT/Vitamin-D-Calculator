---
interface Crumb {
  href: string;
  label: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="max-w-6xl mx-auto px-4 pt-4 text-sm text-gray-500">
  <ol class="flex items-center gap-2 flex-wrap">
    <li>
      <a href="/" class="hover:text-amber-600 transition-colors">Home</a>
    </li>
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {i === crumbs.length - 1 ? (
          <span class="text-gray-700 font-medium" aria-current="page">{c.label}</span>
        ) : (
          <a href={c.href} class="hover:text-amber-600 transition-colors">{c.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
