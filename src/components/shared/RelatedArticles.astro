---
interface Props {
  current: string;
}
const { current } = Astro.props;

const ALL = [
  { href: '/', label: 'Sunlight Calculator', desc: 'How much sun exposure you actually need' },
  { href: '/vitamin-d-reserves', label: 'Reserves Calculator', desc: 'Model your latent stored vitamin D through winter' },
  { href: '/blood-test-interpreter', label: 'Blood Test Interpreter', desc: 'Understand your 25(OH)D result in ng/mL or nmol/L' },
  { href: '/vitamin-d-foods', label: 'Foods High in Vitamin D', desc: 'Searchable table with IU and µg per serving' },
  { href: '/vitamin-d-dosage', label: 'Dosage Guide', desc: 'RDA and repletion by age and 25(OH)D level' },
  { href: '/vitamin-d-deficiency-symptoms', label: 'Deficiency Symptoms', desc: 'Nine signs your 25(OH)D may be low' },
  { href: '/vitamin-d-benefits', label: 'Vitamin D Benefits', desc: 'What the evidence actually shows' },
  { href: '/vitamin-d-winter', label: 'Vitamin D Winter', desc: 'Where and when UVB stops driving synthesis' },
  { href: '/vitamin-d-in-pregnancy', label: 'Vitamin D in Pregnancy', desc: 'Requirements, preeclampsia, and safe supplementation' },
  { href: '/vitamin-d-for-kids', label: 'Vitamin D for Kids', desc: 'Dosages by age, breastfed infants, deficiency signs' },
  { href: '/vitamin-d-toxicity', label: 'Vitamin D Toxicity', desc: 'Safe upper limits and hypervitaminosis D' },
  { href: '/vitamin-d-and-immunity', label: 'Vitamin D and Immunity', desc: 'How 25(OH)D modulates innate and adaptive immunity' },
  { href: '/vitamin-d-and-osteoporosis', label: 'Vitamin D and Osteoporosis', desc: 'Bone density, fractures, and evidence-based dosing' },
  { href: '/vitamin-d-and-sun-safety', label: 'Vitamin D and Sun Safety', desc: 'Getting UVB without skin-cancer risk' },
  { href: '/vitamin-d-unit-converter', label: 'Unit Converter', desc: 'IU ↔ µg and ng/mL ↔ nmol/L' },
  { href: '/how-long-to-raise-vitamin-d', label: 'How Long to Raise 25(OH)D', desc: 'Time-to-steady-state and dose-response kinetics' },
  { href: '/vitamin-d-and-hair-loss', label: 'Vitamin D and Hair Loss', desc: 'What the alopecia and telogen effluvium evidence shows' },
  { href: '/best-time-of-day-for-vitamin-d', label: 'Best Time of Day', desc: 'When to sun-expose vs. when to take a supplement' },
  { href: '/vitamin-d-magnesium-k2', label: 'Vitamin D + Magnesium + K2', desc: 'Cofactor interactions and when combining helps' },
  { href: '/vitamin-d-vs-vitamin-d3', label: 'Vitamin D vs D3', desc: 'Cholecalciferol vs ergocalciferol explained' },
  { href: '/vitamin-d-and-weight-loss', label: 'Vitamin D & Weight Loss', desc: 'What the evidence supports and what it does not' },
  { href: '/vitamin-d-half-life', label: 'Vitamin D Half-Life', desc: 'How long it stays in your body' },
  { href: '/vitamin-d-in-elderly', label: 'Vitamin D in Older Adults', desc: 'Falls, fractures, and dosing after 65' },
  { href: '/vitamin-d-and-mental-health', label: 'Vitamin D and Mental Health', desc: 'Depression, SAD, and anxiety evidence' },
  { href: '/how-to-take-vitamin-d', label: 'How to Take Vitamin D', desc: 'Drops, capsules, timing, and cofactor pairing' },
  { href: '/vitamin-d-testing-guide', label: 'How to Get a 25(OH)D Test', desc: 'What to order, prep, cost, and re-test timing' },
  { href: '/vitamin-d-and-diabetes', label: 'Vitamin D and Diabetes', desc: 'Insulin resistance, T2D prevention, and D2d trial data' },
  { href: '/vitamin-d-and-testosterone', label: 'Vitamin D and Testosterone', desc: 'What supplementation actually does for male hormones' },
  { href: '/vitamin-d-and-thyroid', label: 'Vitamin D and Thyroid', desc: "Hashimoto's, Graves', TPO antibodies" },
  { href: '/vitamin-d-and-sleep', label: 'Vitamin D and Sleep', desc: 'Sleep quality, insomnia, and sleep apnea evidence' },
  { href: '/vitamin-d-for-vegans', label: 'Vitamin D for Vegans', desc: 'Lichen D3, D2, mushrooms, and fortified foods' },
  { href: '/vitamin-d-absorption-issues', label: 'Absorption Issues', desc: 'Why 25(OH)D stays low despite supplementation' },
  { href: '/vitamin-d-and-pcos', label: 'Vitamin D and PCOS', desc: 'Insulin sensitivity, ovulation, fertility' },
  { href: '/vitamin-d-and-heart-health', label: 'Vitamin D and Heart Health', desc: 'BP, cardiovascular events, VITAL trial' },
  { href: '/vitamin-d-and-cancer', label: 'Vitamin D and Cancer', desc: 'Incidence, mortality, and colorectal evidence' },
  { href: '/vitamin-d-and-cognitive-decline', label: 'Vitamin D and Cognitive Decline', desc: "Dementia and Alzheimer's risk associations" },
  { href: '/vitamin-d-and-psoriasis', label: 'Vitamin D and Psoriasis', desc: 'Topical calcipotriene, UVB, and oral adjunct' },
  { href: '/vitamin-d-and-fibromyalgia', label: 'Vitamin D and Fibromyalgia', desc: 'Chronic pain, osteomalacia mimicry' },
  { href: '/vitamins', label: 'All Vitamins & Minerals', desc: 'Complete reference index for every essential nutrient' },
  { href: '/vitamin-b12', label: 'Vitamin B12', desc: 'Cobalamin — pernicious anaemia, neurological deficiency' },
  { href: '/vitamin-c', label: 'Vitamin C', desc: 'Ascorbic acid — collagen, immunity, cold evidence' },
  { href: '/vitamin-a', label: 'Vitamin A', desc: 'Retinol vs beta-carotene, teratogenicity' },
  { href: '/vitamin-e', label: 'Vitamin E', desc: 'Alpha-tocopherol and the failed antioxidant trials' },
  { href: '/vitamin-k', label: 'Vitamin K', desc: 'K1 clotting, K2 bone and vascular health' },
  { href: '/folate', label: 'Folate (B9)', desc: 'Neural tube defect prevention, MTHFR' },
  { href: '/magnesium', label: 'Magnesium', desc: 'Cofactor for 300+ enzymes; forms compared' },
  { href: '/iron', label: 'Iron', desc: 'Anaemia, heme vs non-heme, alternate-day dosing' },
  { href: '/zinc', label: 'Zinc', desc: 'Immunity, wound healing, cold-lozenge evidence' },
  { href: '/vitamin-d-guide', label: 'Complete Guide', desc: 'The full science-backed primer' },
  { href: '/how-it-works', label: 'How It Works', desc: 'The physics behind the calculator' },
  { href: '/glossary', label: 'Glossary', desc: 'Terminology explained' },
  { href: '/faq', label: 'FAQ', desc: '18 answered questions about vitamin D' },
];

const related = ALL.filter((a) => a.href !== current).slice(0, 4);
---

<section class="border-t border-gray-200 mt-12 pt-10">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Related tools &amp; guides</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {related.map((a) => (
      <a href={a.href} class="block bg-white border border-gray-200 rounded-xl p-4 hover:border-amber-400 hover:shadow-md transition-all">
        <p class="text-amber-700 font-semibold text-sm">{a.label} &rarr;</p>
        <p class="text-gray-600 text-sm mt-1">{a.desc}</p>
      </a>
    ))}
  </div>
</section>
