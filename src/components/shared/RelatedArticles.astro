---
interface Props {
  current: string;
}
const { current } = Astro.props;

const ALL = [
  { href: '/', label: 'Sunlight Calculator', desc: 'How much sun exposure you actually need' },
  { href: '/vitamin-d-reserves', label: 'Reserves Calculator', desc: 'Model your latent stored vitamin D through winter' },
  { href: '/blood-test-interpreter', label: 'Blood Test Interpreter', desc: 'Understand your 25(OH)D result in ng/mL or nmol/L' },
  { href: '/vitamin-d-foods', label: 'Foods High in Vitamin D', desc: 'Searchable table with IU and µg per serving' },
  { href: '/vitamin-d-dosage', label: 'Dosage Guide', desc: 'RDA and repletion by age and 25(OH)D level' },
  { href: '/vitamin-d-deficiency-symptoms', label: 'Deficiency Symptoms', desc: 'Nine signs your 25(OH)D may be low' },
  { href: '/vitamin-d-benefits', label: 'Vitamin D Benefits', desc: 'What the evidence actually shows' },
  { href: '/vitamin-d-winter', label: 'Vitamin D Winter', desc: 'Where and when UVB stops driving synthesis' },
  { href: '/vitamin-d-guide', label: 'Complete Guide', desc: 'The full science-backed primer' },
  { href: '/how-it-works', label: 'How It Works', desc: 'The physics behind the calculator' },
  { href: '/glossary', label: 'Glossary', desc: 'Terminology explained' },
  { href: '/faq', label: 'FAQ', desc: '18 answered questions about vitamin D' },
];

const related = ALL.filter((a) => a.href !== current).slice(0, 4);
---

<section class="border-t border-gray-200 mt-12 pt-10">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Related tools &amp; guides</h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {related.map((a) => (
      <a href={a.href} class="block bg-white border border-gray-200 rounded-xl p-4 hover:border-amber-400 hover:shadow-md transition-all">
        <p class="text-amber-700 font-semibold text-sm">{a.label} &rarr;</p>
        <p class="text-gray-600 text-sm mt-1">{a.desc}</p>
      </a>
    ))}
  </div>
</section>
