---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const SITE_URL = 'https://vitamindcalculator.net';
const SITE_NAME = 'Vitamin D Calculator';

const {
  title = 'Vitamin D Calculator — How Much Do You Really Need?',
  description = 'Free science-based vitamin D calculator that estimates your daily vitamin D needs from location, skin type, sun exposure, and lifestyle. Backed by peer-reviewed research from the Endocrine Society and NIH.',
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).toString().replace(/\/$/, '') || SITE_URL;
const ogImageAbs = new URL(ogImage, SITE_URL).toString();

// Site-wide JSON-LD: WebSite + Organization + (on homepage) WebApplication.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: SITE_URL,
  description,
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/favicon.svg`,
};
const webAppJsonLd = isHome ? {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: SITE_NAME,
  url: SITE_URL,
  description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Any (web-based)',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  featureList: [
    'Estimate daily vitamin D needs from sunlight',
    'Location, skin type, and season aware',
    'Interactive map for choosing your location',
    'Peer-reviewed research citations',
  ],
} : null;
