const SITE = 'https://vitamindcalculator.net';
const PAGE_URL = `${SITE}/vitamin-d-and-osteoporosis`;

const medicalJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Vitamin D and Osteoporosis',
  url: PAGE_URL,
  medicalAudience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
