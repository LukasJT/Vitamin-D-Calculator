---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelatedArticles from '../components/shared/RelatedArticles.astro';

const SITE = 'https://vitamindcalculator.net';
const PAGE_URL = `${SITE}/glossary`;

const TERMS: { term: string; abbrev?: string; definition: string }[] = [
  { term: '7-dehydrocholesterol', abbrev: '7-DHC', definition: 'The provitamin D3 precursor stored in the epidermal cell membrane. UVB radiation (280â€“315 nm) opens its B-ring to form previtamin D3, which thermally isomerises to cholecalciferol.' },
  { term: '1,25-dihydroxyvitamin D', abbrev: 'calcitriol; 1,25(OH)â‚‚D', definition: 'The biologically active hormonal form of vitamin D. Produced in the kidney by CYP27B1 hydroxylation of 25(OH)D. Regulates calcium, phosphorus, and bone mineralisation; tightly controlled by PTH.' },
  { term: '25-hydroxyvitamin D', abbrev: '25(OH)D; calcidiol', definition: 'The main circulating form of vitamin D and the standard clinical measure of vitamin D status. Produced in the liver by CYP2R1 hydroxylation of cholecalciferol or ergocalciferol. Half-life ~15â€“25 days.' },
  { term: 'Adequate Intake', abbrev: 'AI', definition: 'A Dietary Reference Intake set when insufficient evidence exists to establish an RDA. Used for infants; 400 IU/day is the AI for vitamin D in infants 0â€“12 months.' },
  { term: 'Adipose sequestration', definition: 'The storage of lipophilic cholecalciferol in body fat, from which it is slowly released to the circulation. Explains the ~60â€“90 day terminal half-life of 25(OH)D in humans and the lower serum 25(OH)D observed in obese individuals at equivalent UVB dose.' },
  { term: 'Cholecalciferol', abbrev: 'vitamin Dâ‚ƒ', definition: 'The animal form of vitamin D. Produced in the skin from 7-dehydrocholesterol under UVB, or ingested from fatty fish, egg yolk, and fortified foods. Preferred supplement form in most guidelines.' },
  { term: 'Ergocalciferol', abbrev: 'vitamin Dâ‚‚', definition: 'The plant/fungal form of vitamin D. Produced by UV irradiation of ergosterol in yeasts and fungi. Raises serum 25(OH)D less effectively than Dâ‚ƒ at equivalent doses.' },
  { term: 'Fitzpatrick skin phototype', definition: 'A six-category classification (Iâ€“VI) of skin colour and UV response introduced by Thomas Fitzpatrick in 1975. Type I always burns and never tans; Type VI is darkly pigmented and rarely burns. Determines minimal erythemal dose and vitamin D synthesis efficiency.' },
  { term: 'Institute of Medicine', abbrev: 'IOM', definition: 'The US body (now the National Academy of Medicine) that established the current Dietary Reference Intakes for vitamin D (2011). Defines deficiency as < 20 ng/mL 25(OH)D.' },
  { term: 'International Unit', abbrev: 'IU', definition: 'A unit used for vitamin dosing. For vitamin D, 1 IU = 0.025 Âµg cholecalciferol; conversely, 1 Âµg = 40 IU.' },
  { term: 'Minimal Erythemal Dose', abbrev: 'MED', definition: 'The lowest UV dose that produces perceptible skin reddening 24 hours after exposure. Varies by skin type: ~200 J/mÂ² for type I, ~1000+ J/mÂ² for type VI.' },
  { term: 'Parathyroid hormone', abbrev: 'PTH', definition: 'The hormone that regulates serum calcium. Elevated PTH is a sensitive marker of vitamin D insufficiency; secondary hyperparathyroidism develops when 25(OH)D falls below ~20 ng/mL.' },
  { term: 'Photoequilibrium', definition: 'The steady-state balance between previtamin D3 production and its UV-driven degradation. Prevents unlimited vitamin D3 synthesis from sunlight alone â€” the reason vitamin D toxicity cannot occur from sun exposure.' },
  { term: 'Recommended Dietary Allowance', abbrev: 'RDA', definition: 'The intake sufficient to meet the needs of 97.5% of healthy individuals. Vitamin D RDA is 600 IU/day for ages 1â€“70 and 800 IU/day for 71+.' },
  { term: 'Rickets', definition: 'The clinical disease of impaired bone mineralisation in growing children caused by vitamin D or calcium deficiency. Presents with bowed legs, growth failure, and delayed dentition. Serum 25(OH)D typically below 12 ng/mL.' },
  { term: 'Osteomalacia', definition: 'The adult analogue of rickets: bone pain, muscle weakness, and reduced mineralisation. Caused by prolonged severe vitamin D or calcium deficiency.' },
  { term: 'Solar zenith angle', abbrev: 'SZA', definition: 'The angle between the sun and the vertical (zenith). Determines the atmospheric path length of sunlight and therefore UVB attenuation. Vitamin D synthesis effectively stops when SZA > 60Â°.' },
  { term: 'Standard Erythemal Dose', abbrev: 'SED', definition: 'A weighted UV exposure unit; 1 SED = 100 J/mÂ² erythemally-weighted UV. Approximates the MED of type I skin.' },
  { term: 'Tolerable Upper Intake Level', abbrev: 'UL', definition: 'The highest daily intake likely to pose no risk of adverse effects in the general population. IOM sets vitamin D UL at 4,000 IU/day for adults.' },
  { term: 'UVB', definition: 'Ultraviolet B radiation, wavelengths 280â€“315 nm. The narrow band responsible for vitamin D3 photosynthesis in skin. Blocked by window glass, ozone, and sunscreen.' },
  { term: 'Vitamin D-binding protein', abbrev: 'DBP; GC-globulin', definition: 'The principal serum carrier of vitamin D metabolites. Genetic polymorphisms (rs4588, rs7041) affect free 25(OH)D and may modulate individual vitamin D response.' },
  { term: 'Vitamin D winter', definition: 'The months during which UVB is insufficient to drive cutaneous vitamin D synthesis. Above ~40Â° latitude, roughly November through February; above ~50Â° latitude, October through March.' },
];

const definedTermList = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Vitamin D Glossary',
  url: PAGE_URL,
  hasDefinedTerm: TERMS.map((t) => ({
    '@type': 'DefinedTerm',
    name: t.term,
    alternateName: t.abbrev,
    description: t.definition,
    inDefinedTermSet: PAGE_URL,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Glossary', item: PAGE_URL },
  ],
};
---

<BaseLayout
  title="Vitamin D Glossary â€” 25(OH)D, Calcitriol, MED, UVB & Terminology"
  description="Definitions of the scientific terms used across the site: 25-hydroxyvitamin D, cholecalciferol, ergocalciferol, calcitriol, Fitzpatrick skin phototypes, minimal erythemal dose, and more."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(definedTermList)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Vitamin D Glossary</h1>
    <p class="text-lg text-gray-600 leading-relaxed mb-8">
      Terminology used across the vitamin D literature, with abbreviations expanded and short
      definitions. Sorted alphabetically.
    </p>

    <dl class="space-y-6">
      {TERMS.map((t) => (
        <div id={t.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
          <dt class="text-lg font-semibold text-gray-900">
            {t.term}
            {t.abbrev && <span class="ml-2 text-sm font-normal text-amber-700">({t.abbrev})</span>}
          </dt>
          <dd class="text-gray-700 leading-relaxed mt-1">{t.definition}</dd>
        </div>
      ))}
    </dl>
  </main>
  <RelatedArticles current="/glossary" />
</BaseLayout>
