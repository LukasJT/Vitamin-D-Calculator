---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Vitamin D Calculator">
  <main class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-6">Contact Us</h1>

    <p class="text-gray-700 text-lg mb-6">
      Have questions, feedback, or concerns about the Vitamin D Calculator? We would love to hear from you.
    </p>

    <div class="bg-white rounded-lg shadow p-6 mb-8">
      <h2 class="text-xl font-semibold mb-3">Get in Touch</h2>
      <p class="text-gray-700 mb-4">
        Whether you have a suggestion for improving the calculator, a question about your results, or just want to say hello, feel free to reach out.
      </p>
      <p class="text-gray-700">
        Email us at
        <a href="mailto:contact@vitamindcalculator.net" class="text-amber-600 hover:text-amber-700 font-medium underline">
          contact@vitamindcalculator.net
        </a>
      </p>
    </div>

    <p class="text-gray-500 text-sm mb-8">
      Please note that we are not medical professionals. For specific health concerns related to vitamin D, consult a qualified healthcare provider.
    </p>

    <nav class="flex gap-4 text-sm text-gray-500">
      <a href="/" class="hover:text-amber-600 underline">Home</a>
      <a href="/about" class="hover:text-amber-600 underline">About</a>
      <a href="/privacy" class="hover:text-amber-600 underline">Privacy Policy</a>
    </nav>
  </main>
</BaseLayout>
