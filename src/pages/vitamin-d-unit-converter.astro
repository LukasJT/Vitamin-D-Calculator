---
import BaseLayout from '../layouts/BaseLayout.astro';
import UnitConverter from '../components/converter/UnitConverter';
import RelatedArticles from '../components/shared/RelatedArticles.astro';

const SITE = 'https://vitamindcalculator.net';
const PAGE_URL = `${SITE}/vitamin-d-unit-converter`;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Vitamin D Unit Converter',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: PAGE_URL,
  description: 'Convert vitamin D units: IU to µg for doses, ng/mL to nmol/L for serum 25(OH)D lab results.',
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Unit Converter', item: PAGE_URL },
  ],
};
---

<BaseLayout
  title="Vitamin D Unit Converter: IU ↔ µg & ng/mL ↔ nmol/L"
  description="Free vitamin D unit converter. Switch between IU and micrograms for supplement doses, and between ng/mL and nmol/L for 25(OH)D blood test results. Includes reference tables."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <UnitConverter client:load />
  <div class="max-w-3xl mx-auto px-4 pb-12">
    <RelatedArticles current="/vitamin-d-unit-converter" />
  </div>
</BaseLayout>
