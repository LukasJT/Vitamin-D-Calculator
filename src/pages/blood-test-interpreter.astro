---
import BaseLayout from '../layouts/BaseLayout.astro';
import BloodTestInterpreter from '../components/interpreter/BloodTestInterpreter';

const SITE = 'https://vitamindcalculator.net';
const PAGE_URL = `${SITE}/blood-test-interpreter`;

const medicalJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Vitamin D Blood Test Result Interpreter',
  url: PAGE_URL,
  description:
    'Interpret your serum 25-hydroxyvitamin D result against IOM and Endocrine Society reference ranges. Instant unit conversion between ng/mL and nmol/L.',
  medicalAudience: { '@type': 'MedicalAudience', audienceType: 'Patient' },
  about: { '@type': 'MedicalCondition', name: 'Vitamin D deficiency' },
  lastReviewed: '2026-05-01',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
    { '@type': 'ListItem', position: 2, name: 'Blood Test Interpreter', item: PAGE_URL },
  ],
};
---

<BaseLayout
  title="Vitamin D Blood Test Result Interpreter | 25(OH)D ng/mL & nmol/L"
  description="Enter your serum 25-hydroxyvitamin D result and get an evidence-based interpretation against IOM and Endocrine Society thresholds. Auto-converts between ng/mL and nmol/L."
  ogType="article"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(medicalJsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <BloodTestInterpreter client:load />

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <hr class="my-8 border-gray-200" />
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
      Understanding your 25(OH)D result
    </h2>
    <p class="text-gray-700 leading-relaxed mb-3">
      The blood test used to assess vitamin D status measures the concentration of
      25-hydroxyvitamin D — the metabolite produced when the liver hydroxylates cholecalciferol
      (D<sub>3</sub>) or ergocalciferol (D<sub>2</sub>). It is preferred over measuring
      cholecalciferol directly because 25(OH)D has a long enough half-life to reflect several
      weeks of cumulative status, and over 1,25-dihydroxyvitamin D (calcitriol) because
      calcitriol is tightly regulated by PTH and doesn't reflect body stores.
    </p>
    <p class="text-gray-700 leading-relaxed mb-3">
      Results are reported in either <strong>ng/mL</strong> (nanograms per millilitre, common
      in the US) or <strong>nmol/L</strong> (nanomoles per litre, common in Europe, Canada,
      Australia). The conversion is <code class="bg-gray-100 px-1 rounded">1 ng/mL = 2.5 nmol/L</code>.
    </p>
    <p class="text-gray-700 leading-relaxed">
      The two major guideline bodies — the Institute of Medicine and the Endocrine Society —
      set slightly different thresholds. The IOM defines sufficiency at ≥ 20 ng/mL (50 nmol/L);
      the Endocrine Society at ≥ 30 ng/mL (75 nmol/L). Both agree that levels below 12 ng/mL
      (30 nmol/L) constitute severe deficiency, and that sustained levels above 100 ng/mL
      (250 nmol/L) approach the toxic range.
    </p>
  </section>
</BaseLayout>
