const SITE = 'https://vitamindcalculator.net';
const PAGE_URL = `${SITE}/vitamin-d-winter`;

const LATITUDE_TABLE = [
  { lat: '<35Ã‚Â°', season: 'Year-round', examples: 'Los Angeles, Phoenix, Atlanta, Sydney, Cairo', months: '12 months of effective UVB' },
  { lat: '35Ã¢â‚¬â€œ42Ã‚Â°', season: 'MarchÃ¢â‚¬â€œOctober', examples: 'San Francisco, Denver, New York, Rome, Tokyo', months: '~8 months' },
  { lat: '42Ã¢â‚¬â€œ50Ã‚Â°', season: 'AprilÃ¢â‚¬â€œSeptember', examples: 'Chicago, Toronto, Vancouver, Paris, Berlin', months: '~6 months' },
  { lat: '50Ã¢â‚¬â€œ55Ã‚Â°', season: 'MayÃ¢â‚¬â€œAugust', examples: 'London, Amsterdam, Warsaw, Edmonton', months: '~4 months' },
  { lat: '55Ã¢â‚¬â€œ60Ã‚Â°', season: 'Late-MayÃ¢â‚¬â€œmid-August', examples: 'Copenhagen, Moscow, Anchorage', months: '~3 months' },
  { lat: '>60Ã‚Â°', season: 'JuneÃ¢â‚¬â€œearly August', examples: 'ReykjavÃƒÂ­k, Fairbanks, TromsÃƒÂ¸', months: '~2 months (some UVB midsummer only)' },
];

const medicalJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  name: 'Vitamin D Winter: Latitude, UVB, and Seasonal Deficiency',
